# ==============================================================================
# eximIA Academy v2 — variáveis de ambiente do serviço único (apps/web)
# ==============================================================================
# Copie para apps/web/.env.local (dev) ou cadastre no EasyPanel (produção).
# NUNCA commite um .env com valores reais.
#
# Modelo de deploy: UM serviço Next.js atende TODOS os tenants por host
# (D1/D2). Não existe mais variável de marca de tenant (NEXT_PUBLIC_TENANT_*);
# a marca vem do banco (`tenants.brand`/`tenants.modules`) em runtime. Ver
# docs/faxina-2026-09/07-guia-easypanel.md para o passo a passo de deploy.
# ==============================================================================

# ------------------------------------------------------------------------------
# Obrigatórias em produção
# ------------------------------------------------------------------------------

# Supabase do projeto (Settings → API). NEXT_PUBLIC_* porque a anon key viaja
# para o navegador; a service role NUNCA leva o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada em e-mails/callbacks quando não há request para
# derivar o host; ver lib/get-base-url.ts). Em produção normalmente o host
# canônico do tenant primário, não este valor fixo.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Domínio base do serviço único (D1). Todo tenant sem domínio próprio resolve
# em `{slug}.{este valor}` por STRING, sem tocar o banco. Ex.:
# NEXT_PUBLIC_APP_BASE_DOMAIN=academy.eximiaventures.com.br
NEXT_PUBLIC_APP_BASE_DOMAIN=

# Pelo menos um provedor de LLM é obrigatório (a IA socrática depende disto).
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Provedores de LLM adicionais (opcional — roteamento de modelo por tenant/uso)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# Microserviços internos (opcionais — o app funciona sem eles, com features degradadas)
# ------------------------------------------------------------------------------

# Token compartilhado entre apps/web e os microserviços internos (blueprint,
# docling). O microserviço rejeita qualquer chamada sem o cabeçalho
# X-Internal-Token correspondente (D15) — NUNCA usar o valor padrão de
# desenvolvimento em produção.
INTERNAL_AUTH_TOKEN=

# Blueprint (geração de curso via IA). Sem isto, a geração de blueprint fica
# indisponível; o resto do app funciona normalmente.
BLUEPRINT_MICROSERVICE_URL=http://localhost:8000

# Docling (extração de tabelas/OCR de PDF/PPTX/DOCX). Sem isto, cai para
# extração básica de texto.
DOCLING_API_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# Bootstrap e cron (opcionais, mas recomendados em produção)
# ------------------------------------------------------------------------------

# E-mail promovido a super_admin automaticamente no primeiro signup dele
# (D13). Equivalente ao parâmetro de banco `app.bootstrap_super_admin_email`
# (Forma A) — no Supabase hospedado use a Forma B (tabela
# `bootstrap_super_admins`) descrita no guia de deploy; esta env documenta o
# valor esperado, não é lida em runtime pelo Next.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# Segredo que autentica as chamadas dos cron jobs (nudge, notificações).
CRON_SECRET=

# ------------------------------------------------------------------------------
# Rate limiting (opcional em dev; RECOMENDADO obrigatório em produção — D16)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Observabilidade (opcional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ------------------------------------------------------------------------------
# Integrações pontuais (opcional)
# ------------------------------------------------------------------------------

# Narração/podcast por IA (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NARRATOR_FEMALE=
ELEVENLABS_VOICE_NARRATOR_MALE=
ELEVENLABS_VOICE_PODCAST_HOST=
ELEVENLABS_VOICE_PODCAST_COHOST=

# E-mail transacional (convites, notificações)
RESEND_API_KEY=

# Busca (usada por agentes de pesquisa/conteúdo)
TAVILY_API_KEY=

# Chave de criptografia dos segredos de integração de tenant (webhooks etc.)
INTEGRATION_ENCRYPT_SECRET=

# Metadados de livros (biblioteca)
ISBNDB_API_KEY=
