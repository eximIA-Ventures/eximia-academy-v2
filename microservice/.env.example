# Blueprint Microservice Configuration

# Service
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_PORT=8000
API_HOST=0.0.0.0

# Supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Microservice Communication
NEXT_APP_URL=http://localhost:3000
INTERNAL_AUTH_TOKEN=dev-token-change-in-prod

# CORS (D15): dominio base do app Next. Subdominios de tenant
# (ex.: cliente.academy.eximiaventures.com.br) sao aceitos automaticamente.
# Deixe em branco em dev (localhost ja e aceito por padrao fora de producao).
APP_BASE_DOMAIN=

# DIALECTICA
DIALECTICA_PATH=../dialectica
MAX_CONCURRENT_JOBS=3
